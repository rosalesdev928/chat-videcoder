# ─── Database (MongoDB Atlas, replica set required by Prisma) ───
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/vibecode?retryWrites=true&w=majority"

# ─── Auth.js ───
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Only outside Vercel (Vercel is detected automatically): AUTH_TRUST_HOST=true

# GitHub OAuth App — callback: <APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth client — redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI provider ───
# "ollama" (default, local, no key) or "anthropic" (recommended for production)
AI_PROVIDER="ollama"
# Chat model. Defaults: ollama → codellama:latest, anthropic → claude-opus-5-5
AI_MODEL=""
# Optional: different model for inline code completion (defaults to AI_MODEL)
AI_COMPLETION_MODEL=""
# Optional (anthropic only): low | medium | high | xhigh | max
AI_EFFORT=""

# Ollama only
OLLAMA_BASE_URL="http://localhost:11434"

# Anthropic only — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=""
